---
import '../styles/global.css';
import WaIcon from '../components/WaIcon.astro';
import { contact, nav, wa } from '../data/site.js';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: boolean;
}
const { title, description, image = '/img/facade-night.jpg', schema = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href) => path === href || path === href.replace('.html', '');

const ld = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'Kayal Breeze Homestay',
  description: 'Homestay with suite and deluxe rooms and 2BHK/3BHK flats, AC and non-AC, for daily or monthly stays.',
  image,
  telephone: ['+919847312283', '+919847392283'],
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'SK Homes, Near Varapuzha Post Office',
    addressLocality: 'Varapuzha, Kochi',
    addressRegion: 'Kerala',
    postalCode: '683517',
    addressCountry: 'IN',
  },
  geo: { '@type': 'GeoCoordinates', latitude: contact.lat, longitude: contact.lng },
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={image}>
<meta property="og:type" content="website">
<meta name="theme-color" content="#022e21">
<link rel="icon" href="/img/favicon.png">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=DM+Sans:opsz,wght@9..40,400;9..40,500&display=swap" rel="stylesheet">
<script is:inline>document.documentElement.classList.add('js')</script>
{schema && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Kayal Breeze, home">Kayal Breeze</a>
  <button class="menu-btn" aria-expanded="false" aria-controls="nav">Menu</button>
  <nav class="nav" id="nav" aria-label="Main">
    <button class="nav-close">Close</button>
    {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
    <a class="btn" href="/contact.html">Enquire</a>
  </nav>
</header>

<main id="main">
  <slot />
</main>

<footer class="site-footer">
  <div class="site-footer__cols">
    <ul><li>Address</li>{contact.addressLines.map((l) => <li>{l}</li>)}</ul>
    <ul><li>Pages</li>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}<li><a href="/contact.html">Enquiry</a></li></ul>
    <ul><li>Contact</li><li><a href={contact.phoneHref}>{contact.phone}</a></li><li><a href={contact.whatsappTel}>{contact.whatsapp}</a></li><li><a href={`mailto:${contact.email}`}>{contact.email}</a></li></ul>
    <ul><li>Stays</li><li>Suite &amp; deluxe rooms</li><li>2BHK &amp; 3BHK flats</li><li>Daily or monthly</li></ul>
  </div>
  <div>
    <p class="site-footer__mark" aria-hidden="true">Kayal Breeze</p>
    <div class="site-footer__legal"><span>© 2026 Kayal Breeze Homestay · SK Group</span><span>Where the breeze meets serenity</span></div>
  </div>
</footer>

<a class="wa-float" href={wa()} target="_blank" rel="noopener" aria-label="Chat with Kayal Breeze on WhatsApp"><WaIcon /></a>

<script>
  import '../scripts/main.js';
</script>
</body>
</html>
